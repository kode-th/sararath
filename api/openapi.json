        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticlesPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Cursor not found"
          },
          "422": {
            "description": "Bad limit, date, or cursor"
          }
        },
        "summary": "List Articles"
      }
