{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sararath-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "vars": {
    "CORS_ORIGINS": "*",
  },
}
