{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@sararath/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:pull": "drizzle-kit pull && rm -rf src/db/generated/meta src/db/generated/relations.ts && rm -f src/db/generated/*.sql && sed -i '/^import { sql } from \"drizzle-orm\"$/d' src/db/generated/schema.ts",
    "deploy": "wrangler deploy --minify",
    "dev": "wrangler dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@scalar/hono-api-reference": "^0.12.10",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
