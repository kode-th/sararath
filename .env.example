# Neon pooled URL, shared by crawlers, the worker, and local dev.
#
# The Python crawlers (crawl/) use the SQLAlchemy scheme:
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/govnews?sslmode=require
#
# The Cloudflare Worker (api/) uses the plain libpq scheme. Put this form in
# api/.dev.vars (see api/.dev.vars.example):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/govnews?sslmode=require
#
# SonarQube Cloud for IDE MCP (never commit real token; export before launching VS Code)
SONARQUBE_TOKEN=
SONARQUBE_ORG=
#
# Host uid/gid so the dev containers run non-root yet can write the bind-mounted
# repo. Set to `id -u` / `id -g`.
LOCAL_UID=1000
LOCAL_GID=1000
