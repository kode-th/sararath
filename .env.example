POSTGRES_USER=govnews
# Set a strong password in .env (copied from this file). Never commit .env.
POSTGRES_PASSWORD=
POSTGRES_DB=govnews
DATABASE_URL=postgresql+psycopg://govnews:${POSTGRES_PASSWORD}@localhost:5432/govnews
# Split deploy: override with Neon pooled URL, e.g.
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/neondb?sslmode=require
# SonarQube Cloud for IDE MCP (never commit real token; export before launching VS Code)
SONARQUBE_TOKEN=
SONARQUBE_ORG=
