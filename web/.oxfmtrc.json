{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "sortImports": {
    "internalPattern": ["@/"]
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortTailwindcss": {
    "stylesheet": "./src/assets/css/styles.css"
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "src/lib/api-schema.d.ts",
    "src/vite-env.d.ts",
    "vite-env.d.ts",
    "bun.lock",
    "dist"
  ]
}
