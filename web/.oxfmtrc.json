{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "sortImports": {
    "internalPattern": ["@/"]
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortTailwindcss": {
    "stylesheet": "./src/styles.css"
  },
  "ignorePatterns": ["src/routeTree.gen.ts", "src/vite-env.d.ts", "bun.lock", "dist"]
}
