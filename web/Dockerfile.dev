FROM node:22-slim

# Match the host uid/gid so the bind-mounted repo (.:/app) stays writable
# without running as root.
ARG UID=1000
ARG GID=1000

# miniflare/workerd (used by @cloudflare/vite-plugin) requires Node; bun is only
# used for installs and scripts.
COPY --from=oven/bun:1 /usr/local/bin/bun /usr/local/bin/bun

# workerd verifies outbound TLS with the system CA store; slim images ship none.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Reuse the image's `node` user, retargeted to the host ids, and pre-own
# node_modules so a fresh named volume inherits non-root ownership.
RUN groupmod -o -g "${GID}" node \
    && usermod -o -u "${UID}" -g "${GID}" node \
    && mkdir -p node_modules \
    && chown -R node:node /app

USER node

EXPOSE 3000

CMD ["sh", "-c", "bun install && exec node node_modules/vite/bin/vite.js dev --host 0.0.0.0 --port 3000"]
