FROM node:22-slim

# miniflare/workerd (used by @cloudflare/vite-plugin) requires Node; bun is only
# used for installs and scripts.
COPY --from=oven/bun:1 /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /app

EXPOSE 3000

CMD ["sh", "-c", "bun install && exec node node_modules/vite/bin/vite.js dev --host 0.0.0.0 --port 3000"]
