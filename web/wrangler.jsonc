{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sararath",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "sararath.fasu.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
