{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Worker: wrangler dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bunx",
      "runtimeArgs": ["wrangler", "dev", "--inspector-port", "9229"],
      "cwd": "${workspaceFolder}/api",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Worker: attach",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "cwd": "${workspaceFolder}/api",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "pytest (crawl)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/crawl",
      "justMyCode": false
    }
  ]
}
