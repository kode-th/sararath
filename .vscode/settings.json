{
  "python.defaultInterpreterPath": "${workspaceFolder}/crawl/.venv/bin/python",
  "python.testing.pytestArgs": ["tests"],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/crawl",
  "python.terminal.useEnvFile": true,
  "python.analysis.extraPaths": ["crawl/src"],
  "python.analysis.stubPath": "crawl/typings",
  "python.analysis.typeCheckingMode": "basic",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "oxc.enable": true,
  "oxc.lint.run": "onSave",
  "oxc.typeAware": true,
  "oxc.disableNestedConfig": false,
  "oxc.path.oxlint": "node_modules/.bin/oxlint",
  "oxc.path.oxfmt": "node_modules/.bin/oxfmt",
  "oxc.path.tsgolint": "node_modules/.bin/tsgolint",
  "js/ts.tsdk.path": "web/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "tailwindCSS.classFunctions": ["cn", "clsx"],
  "tailwindCSS.experimental.configFile": "web/src/assets/css/styles.css",
  "css.customData": [".vscode/tailwind.css-data.json"],
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true,
    "**/.wrangler/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/bun.lock": true,
    "**/uv.lock": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  }
}
